page{background:#081421;color:#e7f1ff;font-size:28rpx}.page{padding:28rpx}.card{background:#11273e;border:1rpx solid #25415e;border-radius:22rpx;padding:28rpx;margin-bottom:22rpx}.muted{color:#9bb3cc;font-size:24rpx}.title{font-size:38rpx;font-weight:700}.row{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.btn{background:#176b9c;color:white;border-radius:12rpx;font-size:27rpx}.number{font-family:monospace;letter-spacing:5rpx}.pill{border-radius:50rpx;padding:10rpx 18rpx;background:#34475c;font-size:23rpx}.balls{display:flex;gap:12rpx;margin:24rpx 0}.ball{width:110rpx;height:110rpx;border-radius:100%;background:#207bb8;display:flex;align-items:center;justify-content:center;font-size:54rpx;font-weight:bold}.stats{display:flex;flex-wrap:wrap;gap:14rpx}.stat{width:44%;background:#182e47;border-radius:14rpx;padding:15rpx}.stat text{display:block}.stat .value{font-size:38rpx;font-weight:bold;margin-top:8rpx}